# Copy to .env.local and fill in. See README.md for what each variable does.

# ── Server only ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Claude model for generate-meta, assist (AI Assist) and citation-probe (default claude-opus-5-5)
ANTHROPIC_MODEL=
# Claude model for ai-check, which the dashboard runs on every page
# (default: ANTHROPIC_MODEL), e.g. claude-sonnet-5-5 to halve scan costs
ANTHROPIC_MODEL_BULK=
PSI_API_KEY=
# Brand voice for AI Assist and meta generation, e.g. brand/brandx.md and BrandX
BRAND_VOICE_FILE=
BRAND_NAME=
# Development only: hosts that skip the private-address check, e.g. localhost
SAFE_FETCH_ALLOW_HOSTS=

# ── Browser ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_SITE_DOMAIN=
NEXT_PUBLIC_SITE_ROOT_PATH=

# Organization JSON-LD (falls back to the site's name and domain)
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_ORG_URL=
NEXT_PUBLIC_ORG_LOGO=
NEXT_PUBLIC_ORG_DESCRIPTION=
# Comma-separated profile URLs
NEXT_PUBLIC_ORG_SAME_AS=

# Sitecore field names the app reads and writes (src/lib/sitecore/field-map.ts).
# Leave empty for the defaults in brackets. AI Assist's Apply is off, with the
# reason, on a page whose template doesn't have the field.
# [pageTitle] [MetaDescription] [OpenGraphTitle] [OpenGraphDescription]
NEXT_PUBLIC_FIELD_TITLE=
NEXT_PUBLIC_FIELD_META_DESCRIPTION=
NEXT_PUBLIC_FIELD_OG_TITLE=
NEXT_PUBLIC_FIELD_OG_DESCRIPTION=
# Author byline, single-line text [authorName]
NEXT_PUBLIC_FIELD_AUTHOR=
# A field that holds the page's JSON-LD [none: structured data is copy-only]
NEXT_PUBLIC_FIELD_JSON_LD=
# FAQ (AccordionItem) datasource fields [heading] [content]
NEXT_PUBLIC_FIELD_FAQ_QUESTION=
NEXT_PUBLIC_FIELD_FAQ_ANSWER=
